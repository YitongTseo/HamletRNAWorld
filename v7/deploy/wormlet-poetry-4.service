[Unit]
Description=Wormlet v7 poetry — process 4 (flasks 7-8, port 8030)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=web
Group=web
WorkingDirectory=/home/web/HamletRNAWorld/v7
EnvironmentFile=-/home/web/.wormlet.env
Environment=PYTHONUNBUFFERED=1
Environment=WORMLET_GENERATIONS_ENABLED=1
Environment=WORMLET_VIEW_MODE=poetry_4
Environment=WORMLET_PASSAGE=full
Environment=WORMLET_N_FLASKS=2
Environment=WORMLET_N_WORMS_PER_FLASK=16
Environment=WORMLET_DATA_DIR=/home/web/HamletRNAWorld/v7/data/poetry-4
# v7.1: independent per-flask embedders (no shared dir / barrier). Distinct seed base.
Environment=WORMLET_EMBEDDING_SEED=30
Environment=WORMLET_GIT_COMMIT=0
ExecStart=/home/web/.venv/bin/python /home/web/HamletRNAWorld/v7/main.py --host 127.0.0.1 --port 8030
Restart=always
RestartSec=5
CPUAffinity=3
MemoryMax=1700M

[Install]
WantedBy=multi-user.target
