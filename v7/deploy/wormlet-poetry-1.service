[Unit]
Description=Wormlet v7 poetry — process 1 (flasks 1-2, port 8000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=web
Group=web
WorkingDirectory=/home/web/HamletRNAWorld/v7
EnvironmentFile=-/home/web/.wormlet.env
Environment=PYTHONUNBUFFERED=1
Environment=WORMLET_GENERATIONS_ENABLED=1
Environment=WORMLET_VIEW_MODE=poetry
Environment=WORMLET_PASSAGE=full
Environment=WORMLET_N_FLASKS=2
Environment=WORMLET_N_WORMS_PER_FLASK=16
Environment=WORMLET_DATA_DIR=/home/web/HamletRNAWorld/v7/data/poetry-1
# v7.1: flasks are fully independent — no shared dir, no cross-process barrier.
# Each flask evolves its own embedder; seeds base+0 and base+1 keep this
# process's two flasks (and all 8 across the 4 processes) distinct.
Environment=WORMLET_EMBEDDING_SEED=0
Environment=WORMLET_GIT_COMMIT=0
ExecStart=/home/web/.venv/bin/python /home/web/HamletRNAWorld/v7/main.py --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
CPUAffinity=0
MemoryMax=1700M

[Install]
WantedBy=multi-user.target
